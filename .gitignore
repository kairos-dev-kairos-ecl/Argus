# =============================================================================
# ArgusXDR — Production .gitignore
# =============================================================================

# Planning & local tooling (GSD workflow artifacts, never committed)
.planning/
.claude/
.claire/
.worktrees/

# ─── Design & Internal Tooling ────────────────────────────────────────────────
# Figma design exports and reference images — not part of the codebase
Figma/

# Graph analysis output — local tooling artifact
graphify-out/

# Internal planning and specification documents
ARGUS_XDR_PLATFORM_SPEC.md
Argus-Design.md
INFISICAL_SETUP.md
.DELIVERY_SUMMARY.md

# AI tool internal plans
docs/superpowers/

# ─── Local Artifacts & Test Output ────────────────────────────────────────────
argus_connector_research_report.md
argus-validate-results.json
argus-server.log
test_sensor.py
test_harness/validation_results.json
scripts/live_test.py

# ─── Binaries & Build Outputs ─────────────────────────────────────────────────
# Go build outputs
bin/
*.exe
*.out
/argus
/argus-api
pipeline.test.*

# Web build
web/dist/
web/.env.local

# ─── Secrets & Credentials ────────────────────────────────────────────────────
# Never commit secrets — use environment variables or the secrets CLI
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
argus.key
secrets.yml
secrets.yaml

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
*.egg-info/
test_harness/venv/
test_harness/models/*.gguf
test_harness/models/*.bin
test_harness/models/*.safetensors

# ─── Node ─────────────────────────────────────────────────────────────────────
web/node_modules/

# ─── Docker ───────────────────────────────────────────────────────────────────
.env.docker
docker-compose.override.yml

# ─── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.log
build.log

# IDE directories (keep per-project settings in separate dotfiles repo if needed)
.vscode/
.idea/
*.iml

# ─── Local Dev Notes ──────────────────────────────────────────────────────────
# Obsidian vault is personal dev notes, not part of the codebase
.obsidian-vault/
