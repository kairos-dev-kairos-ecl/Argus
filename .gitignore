# =============================================================================
# ArgusXDR — Production .gitignore
# =============================================================================

# Planning & local tooling (GSD workflow artifacts, never committed)
.planning/
.claude/
.claude/worktrees/
.worktrees/

# ─── Binaries & Build Outputs ─────────────────────────────────────────────────
# Go build outputs
bin/
*.exe
*.out
argus
argus-api
pipeline.test.*

# Web build
web/dist/
web/.env.local

# ─── Secrets & Credentials ────────────────────────────────────────────────────
# Never commit secrets — use environment variables or the secrets CLI
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
argus.key
secrets.yml
secrets.yaml

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
*.egg-info/
test_harness/venv/
test_harness/models/*.gguf
test_harness/models/*.bin
test_harness/models/*.safetensors

# ─── Node ─────────────────────────────────────────────────────────────────────
web/node_modules/

# ─── Docker ───────────────────────────────────────────────────────────────────
.env.docker
docker-compose.override.yml

# ─── OS & Editor Artifacts ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.log
build.log

# IDE directories (keep per-project settings in separate dotfiles repo if needed)
.vscode/
.idea/
*.iml

# ─── Local Dev Notes ──────────────────────────────────────────────────────────
# Obsidian vault is personal dev notes, not part of the codebase
.obsidian-vault/
