import { useSignalStore } from '../stores/signal'
import { LAYERS } from '../types'

/**
 * SignalStreamFilter Component
 *
 * Provides filtering UI for:
 * - Layer selection (L1-L10)
 * - Minimum severity (1-5)
 * - Search text in message
 * - Clear all filters button
 */
export const SignalStreamFilter: React.FC = () => {
  const { filter, updateFilter } = useSignalStore()

  const handleLayerChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const value = e.target.value
    updateFilter({
      layers: value ? [value as typeof LAYERS[number]] : undefined
    })
  }

  const handleSeverityChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const value = e.target.value
    updateFilter({
      severity_min: value ? parseInt(value) : undefined
    })
  }

  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const value = e.target.value
    updateFilter({
      search: value || undefined
    })
  }

  const handleClear = () => {
    updateFilter({
      layers: undefined,
      severity_min: undefined,
      category: undefined,
      search: undefined
    })
  }

  return (
    <div className="flex gap-3 p-4 bg-slate-900 border-b border-slate-800 flex-wrap">
      {/* Layer selector */}
      <div className="flex flex-col gap-1">
        <label className="text-xs font-semibold text-slate-400">Layer</label>
        <select
          value={filter.layers?.[0] || ''}
          onChange={handleLayerChange}
          className="px-3 py-2 bg-slate-800 border border-slate-700 rounded text-sm text-slate-300 hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Layers</option>
          {LAYERS.map((layer) => (
            <option key={layer} value={layer}>
              {layer}
            </option>
          ))}
        </select>
      </div>

      {/* Severity selector */}
      <div className="flex flex-col gap-1">
        <label className="text-xs font-semibold text-slate-400">Min Severity</label>
        <select
          value={filter.severity_min?.toString() || ''}
          onChange={handleSeverityChange}
          className="px-3 py-2 bg-slate-800 border border-slate-700 rounded text-sm text-slate-300 hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          <option value="">All Severities</option>
          {[1, 2, 3, 4, 5].map((s) => (
            <option key={s} value={s.toString()}>
              Severity {s}+
            </option>
          ))}
        </select>
      </div>

      {/* Search input */}
      <div className="flex flex-col gap-1 flex-1 min-w-[200px]">
        <label className="text-xs font-semibold text-slate-400">Search Message</label>
        <input
          type="text"
          placeholder="Search..."
          value={filter.search || ''}
          onChange={handleSearchChange}
          className="px-3 py-2 bg-slate-800 border border-slate-700 rounded text-sm text-slate-300 placeholder-slate-500 hover:border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      {/* Clear button */}
      <div className="flex flex-col gap-1 justify-end">
        <button
          onClick={handleClear}
          className="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-sm rounded border border-slate-700 hover:border-slate-600 transition-colors"
        >
          Clear Filters
        </button>
      </div>
    </div>
  )
}
